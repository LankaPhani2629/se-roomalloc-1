# ========================================================
# COLLEGE HOSTEL ROOM ALLOCATION SYSTEM - ENVIRONMENT CONFIG
# ========================================================
# Copy this file to .env and configure values before starting the application.
# NEVER commit your production .env file to version control.

# --------------------------------------------------------
# 1. Core Django Settings
# --------------------------------------------------------
# Set to False in production! Set to True only for local development.
DEBUG=False

# Generate a strong secret key for production:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Comma-separated list of valid hostnames/domains for this deployment:
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app,.railway.app

# Comma-separated list of trusted origins for CSRF POST requests (include scheme):
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app,https://*.railway.app

# --------------------------------------------------------
# 2. Database Configuration (Supabase PostgreSQL)
# --------------------------------------------------------
# For Supabase:
# Go to your Supabase Project Dashboard -> Project Settings -> Database -> Connection String (URI).
# Mode: "Transaction" (recommended for serverless/containers on port 6543) or "Session" / Direct (port 5432).
#
# Examples:
# Direct:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Connection Pooler (PgBouncer - IPv4 compatible):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# If DATABASE_URL is unset, defaults to local SQLite: db.sqlite3
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Connection pooling lifetime in seconds
DB_CONN_MAX_AGE=600

# --------------------------------------------------------
# 3. Security, HTTPS & SSL
# --------------------------------------------------------
# Enforce SSL redirection in production:
SECURE_SSL_REDIRECT=True

# Strict-Transport-Security duration in seconds (31536000 = 1 year):
SECURE_HSTS_SECONDS=31536000

# --------------------------------------------------------
# 4. Email Configuration (SMTP)
# --------------------------------------------------------
# For local dev, console backend is used if unset.
# For production, specify SMTP credentials:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=hostel-notifications@college.edu
EMAIL_HOST_PASSWORD=your-app-specific-email-password
DEFAULT_FROM_EMAIL=Hostel Administration <hostel-notifications@college.edu>

# --------------------------------------------------------
# 5. Rate Limiting Limits
# --------------------------------------------------------
RATE_LIMIT_AUTH=15
RATE_LIMIT_GLOBAL=200
